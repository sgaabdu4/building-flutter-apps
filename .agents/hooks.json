{
  "hard-eng": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 \"$(git rev-parse --show-toplevel)/.hooks/hard-eng.py\" session agy",
        "timeout": 60
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.hooks/polling.py\" 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 \"$(git rev-parse --show-toplevel)/.hooks/hard-eng.py\" stop agy",
        "timeout": 3600
      }
    ]
  }
}

{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.hooks/hard-eng.py\" session codex",
            "timeout": 3600,
            "statusMessage": "Hard Eng: updating project setup"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.hooks/hard-eng.py\" stop codex",
            "timeout": 3600,
            "statusMessage": "Hard Eng: verifying changes"
          }
        ]
      }
    ]
  }
}
